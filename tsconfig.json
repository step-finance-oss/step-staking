{
  "compilerOptions": {
    "types": [
      "node",
      "mocha"
    ],
    "lib": [
      "ES2022"
    ],
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "target/types/**/*.ts"
  ]
}
