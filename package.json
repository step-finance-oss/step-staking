{
  "name": "step-staking",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "anchor build --ignore-keys --arch v3",
    "test": "npm run build && npm run test:unit && SKIP_BUILD=1 bash scripts/test-local.sh",
    "test:unit": "cargo test --workspace --locked",
    "test:integration": "bash scripts/test-local.sh",
    "compile:tests": "tsc",
    "test:client": "mocha --timeout 120000 .test-build/tests/step-staking.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --trailing-comma es5 \"{tests,migrations}/**/*.{ts,js}\" --check",
    "lint:fix": "prettier --trailing-comma es5 \"{tests,migrations}/**/*.{ts,js}\" --write"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.0.0",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "toml": "5.0.1",
    "jayson": "5.0.0"
  }
}
